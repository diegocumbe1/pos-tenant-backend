PORT=3001
NODE_ENV=development

# Para queries en runtime (pooler — pgbouncer)
DATABASE_URL=":6543/postgres?pgbouncer=true"

# Para migraciones (conexión directa — sin pgbouncer)
DIRECT_URL=":5432/postgres"

# Supabase Auth (https://app.supabase.com/project/_/settings/api)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
SUPABASE_ASSETS_BUCKET="lynko-assets"
SUPABASE_INVITE_REDIRECT_TO="http://localhost:3000/auth/accept-invite"
SUPABASE_RECOVERY_REDIRECT_TO="http://localhost:3000/reset-password"

# WhatsApp (whatsapp-web.js) — per-tenant+branch LocalAuth sessions
WA_SESSION_DIR="./.wa-sessions"
WA_PUPPETEER_HEADLESS=true
WA_PAIR_TIMEOUT_MS=60000

PORT=3001
NODE_ENV=development

# Zona horaria del proceso. TODO el sistema opera en hora Colombia.
# En la nube el host suele ser UTC; sin esta env, los cortes de día/semana/mes
# (arqueo, finanzas, plataforma) se calcularían mal. main.ts también la fuerza
# por defecto, pero conviene definirla explícita en el entorno de prod.
TZ=America/Bogota

# Seed seguro para QA/prod: por defecto NO crea tenants/usuarios/productos demo.
# QA showcase: npm run db:seed && npm run seed:qa-showcase
# Demo legacy local: SEED_DEMO_DATA=true npm run db:seed
SEED_DEMO_DATA=false

# Para queries en runtime (Supabase pooler / transaction mode)
# Copiar desde Supabase: Project Settings > Database > Connection string > Transaction pooler
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true"

# Para migraciones (conexión directa, sin pgbouncer)
# Copiar desde Supabase: Project Settings > Database > Connection string > Direct connection
DIRECT_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres"

# Supabase Auth (https://app.supabase.com/project/_/settings/api)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
SUPABASE_ASSETS_BUCKET="lynko-assets"
# Bucket NO público para blobs internos (sesión de WhatsApp). Se crea solo.
SUPABASE_PRIVATE_BUCKET="lynko-private"
# Tope por archivo del bucket privado. 50MB es el máximo del plan Free.
SUPABASE_PRIVATE_MAX_FILE_SIZE="50MB"
SUPABASE_INVITE_REDIRECT_TO="http://localhost:3000/auth/accept-invite"
SUPABASE_RECOVERY_REDIRECT_TO="http://localhost:3000/reset-password"

# URL pública del frontend para el QR/enlace del recibo (/r/:token).
# Local: http://localhost:3000 · Prod: https://uselynko.com
PUBLIC_APP_URL="http://localhost:3000"

# URL pública de ESTA API, con el prefijo /api/v1 incluido. Se usa para armar la
# "URL de Eventos" que se pega en el dashboard de Wompi. Sin esto, la consola
# muestra solo la ruta y avisa que falta. Wompi no puede llamar a localhost:
# en desarrollo hay que exponerla con un túnel (ngrok).
PUBLIC_API_URL=""

# CORS: orígenes permitidos en prod (lista separada por comas, SIN slash final
# y con esquema). Vacío = refleja cualquier origen (solo dev). Aplica igual al
# HTTP y al WebSocket (/realtime). Va el origen del FRONT, no el de la API.
# Prod: CORS_ORIGINS="https://uselynko.com,https://www.uselynko.com,https://admin.uselynko.com"
CORS_ORIGINS=""
CORS_MAX_AGE_SECONDS=86400

# WhatsApp (whatsapp-web.js) — sesión por tenant+branch, persistida en el bucket
# privado de Supabase Storage (RemoteAuth). WA_SESSION_DIR es solo scratch local.
WA_SESSION_DIR="./.wa-sessions"
# Cada backup sube el zip de sesión (~30MB) si cambió. Default 30 min, mínimo 60s.
WA_BACKUP_SYNC_MS=1800000
# Restaurar la sesión al arrancar descarga ~30MB del bucket. Default: solo en
# producción, para no quemar la cuota de egress con cada reinicio en dev.
WA_RESTORE_ON_BOOT=false
# Carpeta de los respaldos de sesión en el bucket. Vacío = 'whatsapp-sessions'
# en producción y 'whatsapp-sessions-dev' fuera de ella, para que emparejar o
# desvincular en local nunca toque el respaldo de un negocio en prod.
WA_SESSION_STORAGE_PREFIX=
# En un deploy el contenedor viejo sigue vivo hasta que el nuevo pasa el
# healthcheck. Restaurar de inmediato pone dos sesiones con las mismas
# credenciales y WhatsApp manda CONFLICT. Esto espera a que el viejo se apague.
WA_RESTORE_DELAY_MS=25000
# Tope del respaldo final al recibir SIGTERM (comprimir + subir ~30MB).
WA_SHUTDOWN_BACKUP_TIMEOUT_MS=15000
# Cuánto espera el cliente antes de reclamar una sesión que otro tomó.
WA_TAKEOVER_TIMEOUT_MS=10000
WA_PUPPETEER_HEADLESS=true
WA_PAIR_TIMEOUT_MS=60000
WA_READY_TIMEOUT_MS=120000
WA_PUPPETEER_TIMEOUT_MS=60000
WA_MAX_ACTIVE_SESSIONS=1
# El mismo aviso (plantilla + número + texto) no se reenvía dentro de esta
# ventana: frena dobles clics y refrescos de la confirmación. Default 10 min.
WA_DEDUPE_WINDOW_MS=600000
# Reserva pública sin login: topes de avisos por hora (por negocio y por número).
WA_PUBLIC_MAX_PER_TENANT_HOUR=30
WA_PUBLIC_MAX_PER_PHONE_HOUR=3

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@uselynko.com

# Amazon Alexa Custom Skill: required to accept signed requests.
ALEXA_SKILL_ID=

# Activación por voz (todas obligatorias para responder con datos reales).
# Hash scrypt de la frase hablada; generalo con `npm run alexa:hash`.
ALEXA_ACTIVATION_SECRET_HASH=
# context.System.user.userId de la cuenta de Amazon autorizada.
ALEXA_ALLOWED_USER_ID=
# Opcional: context.System.device.deviceId del Echo autorizado. Vacío = cualquier dispositivo de esa cuenta.
ALEXA_ALLOWED_DEVICE_ID=
# ID del usuario Lynko cuyos permisos se usan al responder.
ALEXA_LYNKO_USER_ID=
# Duración de la autorización, en días (1 a 30).
ALEXA_AUTH_TTL_DAYS=7

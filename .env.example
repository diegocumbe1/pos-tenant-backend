PORT=3001
NODE_ENV=development

# Para queries en runtime (Supabase pooler / transaction mode)
# Copiar desde Supabase: Project Settings > Database > Connection string > Transaction pooler
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true"

# Para migraciones (conexión directa, sin pgbouncer)
# Copiar desde Supabase: Project Settings > Database > Connection string > Direct connection
DIRECT_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres"

# Supabase Auth (https://app.supabase.com/project/_/settings/api)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
SUPABASE_ASSETS_BUCKET="lynko-assets"
SUPABASE_INVITE_REDIRECT_TO="http://localhost:3000/auth/accept-invite"
SUPABASE_RECOVERY_REDIRECT_TO="http://localhost:3000/reset-password"

# WhatsApp (whatsapp-web.js) — per-tenant+branch LocalAuth sessions
WA_SESSION_DIR="./.wa-sessions"
WA_PUPPETEER_HEADLESS=true
WA_PAIR_TIMEOUT_MS=60000
WA_READY_TIMEOUT_MS=120000
WA_PUPPETEER_TIMEOUT_MS=60000
WA_MAX_ACTIVE_SESSIONS=1

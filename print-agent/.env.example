# URL del backend Lynko (nube o local). Sin slash final.
API_URL=http://localhost:3001

# Credenciales de un usuario con permisos restaurant:print:* y restaurant:printers:manage
AGENT_EMAIL=owner@restaurante.com
AGENT_PASSWORD=cambia-esto

# El tenant se deriva automáticamente del login (no se configura).
# BRANCH_ID: opcional. Solo si el usuario atiende VARIAS sedes, para indicar
# cuál sirve esta impresora. Con una sola sede, se autoselecciona; déjalo vacío.
# BRANCH_ID=branch-xxxxxxxx

# Ritmo (ms)
POLL_MS=3000
HEARTBEAT_MS=20000
TCP_TIMEOUT_MS=4000

# ── Corte de papel ───────────────────────────────────────────────────────────
# partial (default): corte parcial con avance (GS V B). El ticket queda unido
#   por una pestaña — algunas impresoras de cocina siguen pitando hasta arrancarlo.
# full: avance (FULL_CUT_LF líneas) + corte total (GS V 0). El ticket se separa
#   y el buzzer se detiene solo. Usa este modo si la impresora pita sin parar.
CUT_MODE=full

# Líneas de avance antes del corte total (solo CUT_MODE=full). Sube si corta sobre el texto.
FULL_CUT_LF=5

# Unidades de avance del corte parcial (solo CUT_MODE=partial).
# CUT_FEED_UNITS=96

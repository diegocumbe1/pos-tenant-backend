# URL del backend Lynko (nube o local). Sin slash final.
API_URL=http://localhost:3001

# Credenciales de un usuario con permisos restaurant:print:* y restaurant:printers:manage
AGENT_EMAIL=owner@restaurante.com
AGENT_PASSWORD=cambia-esto

# El tenant se deriva automáticamente del login (no se configura).
# BRANCH_ID: opcional. Solo si el usuario atiende VARIAS sedes, para indicar
# cuál sirve esta impresora. Con una sola sede, se autoselecciona; déjalo vacío.
# BRANCH_ID=branch-xxxxxxxx

# Ritmo (ms)
POLL_MS=3000
HEARTBEAT_MS=20000
TCP_TIMEOUT_MS=4000

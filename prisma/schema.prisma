generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Multi-tenancy Core ───────────────────────────────────────────────────────

model Tenant {
  id                   String                @id
  name                 String
  documentId           String?
  plan                 String                @default("BASIC") // "BASIC" | "PRO" | "PREMIUM"
  verticalId           String?
  vertical             BusinessVertical?     @relation(fields: [verticalId], references: [id])
  planId               String?
  planRef              SubscriptionPlan?     @relation(fields: [planId], references: [id])
  // Estado operativo de la cuenta (controla el acceso a la app del tenant).
  status               TenantStatus          @default(ACTIVE)
  // Overrides de features por tenant (espeja Tenant.featureOverrides del FE).
  // Pisan el default del plan. null = sin overrides (hereda del plan).
  featureOverrides     Json?
  // Suscripción comercial vigente (entidad propia).
  subscription         Subscription?
  subscriptionPayments SubscriptionPayment[]
  billingContacts      BillingContact[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?

  users                User[]
  branches             Branch[]
  products             Product[]
  categories           ProductCategory[]
  ingredients          Ingredient[]
  stockMovements       StockMovement[]
  menuPublicConfig     MenuPublicConfig?
  areas                Area[]
  tables               RestaurantTable[]
  orders               Order[]
  kitchenTickets       KitchenTicket[]
  paymentSplits        PaymentSplit[]
  reservations         Reservation[]
  expenses             Expense[]
  payrolls             Payroll[]
  financeGoals         FinanceGoal[]
  roles                Role[]
  barberSettings       BarberSettings[]
  barberServices       BarberService[]
  barberStaff          BarberStaff[]
  barberCustomers      BarberCustomer[]
  barberAppointments   BarberAppointment[]
  retailCategories     RetailCategory[]
  retailProducts       RetailProduct[]
  retailStockMovements RetailStockMovement[]
  retailCustomers      RetailCustomer[]
  retailSales          RetailSale[]
  retailPurchaseItems  RetailPurchaseItem[]
  publicSites          PublicSite[]
  orderEvents          OrderEvent[]
  orderClaims          OrderClaim[]
  printers             Printer[]
  printJobs            PrintJob[]
  receiptShares        ReceiptShare[]
  cashSessions         CashSession[]
  notificationEvents   NotificationEvent[]
  notificationPrefs    NotificationPreference[]
  webPushSubscriptions WebPushSubscription[]
  platformMessages     PlatformMessage[]

  @@index([plan])
  @@index([verticalId])
  @@index([planId])
  @@map("tenants")
}

model BusinessVertical {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants Tenant[]
  plans   VerticalPlan[]

  @@index([isActive])
  @@map("business_verticals")
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  priceCOP    Int      @default(0)
  currency    String   @default("COP")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants   Tenant[]
  verticals VerticalPlan[]

  @@index([isActive])
  @@map("subscription_plans")
}

model VerticalPlan {
  verticalId String
  planId     String
  isActive   Boolean @default(true)

  vertical BusinessVertical @relation(fields: [verticalId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([verticalId, planId])
  @@index([planId])
  @@index([isActive])
  @@map("vertical_plans")
}

model Branch {
  id          String   @id
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  address     String?
  phone       String?
  // Datos de pago del negocio (cuenta bancaria, Nequi/Daviplata, QR) que salen
  // en el POS al cobrar y en el recibo. JSON con forma BranchPaymentInfo (FE).
  paymentInfo Json?
  createdAt   DateTime @default(now())

  products             Product[]
  categories           ProductCategory[]
  ingredients          Ingredient[]
  stockMovements       StockMovement[]
  areas                Area[]
  tables               RestaurantTable[]
  orders               Order[]
  reservations         Reservation[]
  expenses             Expense[]
  payrolls             Payroll[]
  financeGoals         FinanceGoal[]
  userBranches         UserBranch[]
  barberSettings       BarberSettings?
  barberServices       BarberService[]
  barberStaff          BarberStaff[]
  barberCustomers      BarberCustomer[]
  barberAppointments   BarberAppointment[]
  retailCategories     RetailCategory[]
  retailProducts       RetailProduct[]
  retailStockMovements RetailStockMovement[]
  retailCustomers      RetailCustomer[]
  retailSales          RetailSale[]
  retailPurchaseItems  RetailPurchaseItem[]
  publicSites          PublicSite[]
  printers             Printer[]
  printJobs            PrintJob[]
  cashSessions         CashSession[]
  notificationEvents   NotificationEvent[]
  webPushSubscriptions WebPushSubscription[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("branches")
}

// ─── Barberia ────────────────────────────────────────────────────────────────

model BarberSettings {
  id                     String   @id @default(cuid())
  tenantId               String
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId               String
  branch                 Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  phone                  String?
  city                   String?
  neighborhood           String?
  whatsapp               String?
  timezone               String   @default("America/Bogota")
  currency               String   @default("COP")
  logoUrl                String?
  bookingSlug            String   @unique
  bookingMode            String   @default("services")
  businessHours          Json     @default("{}")
  publicBookingCopy      Json     @default("{}")
  onlineBookingEnabled   Boolean  @default(true)
  publicProfilePublished Boolean  @default(true)
  whatsappEnabled        Boolean  @default(false)
  loyaltyEnabled         Boolean  @default(false)
  themeTemplateId        String   @default("studio")
  themePrimaryColor      String   @default("#6366f1")
  themeAccentColor       String   @default("#22c55e")
  themeInkColor          String   @default("#0f172a")
  themeLogoMode          String?  @default("initials")
  themeLogoImageUrl      String?
  themeBannerImageUrl    String?
  heroImageUrl           String?
  heroTitle              String?
  heroDescription        String?
  shortName              String?
  tagline                String?
  eyebrow                String?
  description            String?
  highlights             String[] @default([])
  stats                  Json     @default("[]")
  galleryImages          Json     @default("[]")
  socialInstagram        String?
  socialFacebook         String?
  socialTiktok           String?
  socialWebsite          String?
  instagramProfileUrl    String?
  instagramPosts         String[] @default([])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([branchId])
  @@index([tenantId])
  @@map("barber_settings")
}

model PublicSite {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId          String
  branch            Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  slug              String    @unique
  publishedSlug     String?
  status            String    @default("draft")
  vertical          String    @default("barber")
  publishedAt       DateTime?
  publishedByUserId String?
  draftPayload      Json      @default("{}")
  publishedPayload  Json?

  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?

  themePrimary        String  @default("#6366f1")
  themeAccent         String  @default("#22c55e")
  themeInk            String  @default("#0f172a")
  themeBackground     String  @default("#ffffff")
  themeSurface        String  @default("#f8fafc")
  themeRadius         String  @default("md")
  themeSecondary      String?
  themeMode           String?
  themeBackgroundType String?
  themeFontStyle      String?
  themeLogoUrl        String?
  themeFaviconUrl     String?
  themeWhatsapp       Json?

  shortName    String?
  neighborhood String?
  city         String?
  phone        String?
  whatsapp     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections       PublicSiteSection[]
  assets         PublicSiteAsset[]
  socialLinks    PublicSiteSocialLink[]
  instagramPosts PublicSiteInstagramPost[]
  stats          PublicSiteStat[]
  highlights     PublicSiteHighlight[]

  @@unique([branchId])
  @@index([tenantId])
  @@index([branchId, status])
  @@index([slug, status])
  @@map("public_sites")
}

model PublicSiteSection {
  id        String     @id @default(cuid())
  siteId    String
  site      PublicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type      String
  isVisible Boolean    @default(true)
  sortOrder Int        @default(0)
  width     String     @default("contained")
  density   String     @default("comfortable")

  title     String?
  eyebrow   String?
  subtitle  String?
  body      String?
  ctaLabel  String?
  ctaAction String?
  ctaHref   String?
  assetIds  String[] @default([])
  settings  Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, sortOrder])
  @@index([siteId, type])
  @@map("public_site_sections")
}

model PublicSiteAsset {
  id         String     @id @default(cuid())
  siteId     String
  site       PublicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  kind       String
  url        String
  path       String?
  bucket     String?
  alt        String
  width      Int?
  height     Int?
  fit        String     @default("cover")
  focalPoint String     @default("center")
  isVisible  Boolean    @default(true)
  sortOrder  Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, kind])
  @@index([siteId, sortOrder])
  @@map("public_site_assets")
}

model PublicSiteSocialLink {
  id        String     @id @default(cuid())
  siteId    String
  site      PublicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  provider  String
  label     String
  url       String
  isVisible Boolean    @default(true)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, provider])
  @@index([siteId, sortOrder])
  @@map("public_site_social_links")
}

model PublicSiteInstagramPost {
  id        String     @id @default(cuid())
  siteId    String
  site      PublicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url       String
  kind      String
  isVisible Boolean    @default(true)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, sortOrder])
  @@map("public_site_instagram_posts")
}

model PublicSiteStat {
  id        String     @id @default(cuid())
  siteId    String
  site      PublicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  label     String
  value     String
  isVisible Boolean    @default(true)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, sortOrder])
  @@map("public_site_stats")
}

model PublicSiteHighlight {
  id        String     @id @default(cuid())
  siteId    String
  site      PublicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  label     String
  isVisible Boolean    @default(true)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, sortOrder])
  @@map("public_site_highlights")
}

model BarberService {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  durationMin     Int
  priceCOP        Int
  // Costo de insumos del servicio (tintes, agujas, pigmentos...). Capturado a
  // mano: barbería no tiene inventario todavía. Sin esto la vertical queda
  // fuera de cualquier cálculo de margen.
  costCOP         Int      @default(0)
  // Modo recursos: bloques de reserva adicionales al base (1h = priceCOP).
  // [{ minutes: number, priceCOP?: number | null }]. priceCOP null = derivado.
  durationOptions Json     @default("[]")
  color           String?
  imageUrls       String[] @default([])
  category        String?
  resultDuration  String?
  retouchPriceCOP Int?
  retouchNote     String?
  primaryImageUrl String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staffServices BarberStaffService[]
  appointments  BarberAppointment[]
  assets        BarberServiceAsset[]

  @@unique([branchId, name])
  @@index([tenantId])
  @@index([branchId, isActive])
  @@index([category])
  @@map("barber_services")
}

model BarberServiceAsset {
  id                  String        @id @default(cuid())
  tenantId            String
  serviceId           String
  service             BarberService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  url                 String
  alt                 String?
  kind                String        @default("gallery") // "primary" | "gallery" | "before" | "after"
  fit                 String        @default("cover") // "cover" | "contain"
  focalPoint          String        @default("center") // "center" | "top" | "bottom" | "left" | "right"
  showInPublicGallery Boolean       @default(true)
  sortOrder           Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([tenantId])
  @@index([serviceId, sortOrder])
  @@index([serviceId, kind])
  @@map("barber_service_assets")
}

model BarberStaff {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId    String?
  name      String
  email     String?
  phone     String?
  avatarUrl String?
  color     String?
  bio       String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services     BarberStaffService[]
  appointments BarberAppointment[]

  @@unique([branchId, name])
  @@index([tenantId])
  @@index([branchId, isActive])
  @@map("barber_staff")
}

model BarberStaffService {
  staffId   String
  serviceId String
  staff     BarberStaff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   BarberService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([staffId, serviceId])
  @@index([serviceId])
  @@map("barber_staff_services")
}

model BarberCustomer {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  email       String?
  notes       String?
  tags        String[]  @default([])
  totalVisits Int       @default(0)
  lastVisitAt DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  appointments BarberAppointment[]

  @@unique([branchId, phone])
  @@index([tenantId])
  @@index([branchId, name])
  @@map("barber_customers")
}

model BarberAppointment {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId   String
  customer     BarberCustomer @relation(fields: [customerId], references: [id])
  serviceId    String
  service      BarberService  @relation(fields: [serviceId], references: [id])
  staffId      String?
  staff        BarberStaff?   @relation(fields: [staffId], references: [id])
  scheduledAt  DateTime
  scheduledEnd DateTime
  // Precio y costo congelados al completar la cita. Hasta ahora el ingreso se
  // leía del BarberService ACTUAL: reprecio o renombrar reescribía el histórico
  // entero. null = cita no completada, o completada antes de este cambio.
  priceCOP     Int?
  costCOP      Int?
  status       String         @default("SCHEDULED")
  source       String         @default("manual")
  notes        String?
  cancelReason String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([tenantId])
  @@index([branchId, status])
  @@index([staffId, scheduledAt])
  @@index([customerId, scheduledAt])
  @@map("barber_appointments")
}

// ─── Users & RBAC ────────────────────────────────────────────────────────────

model User {
  id              String    @id // mapea a auth.users.id de Supabase (UUID)
  tenantId        String? // NULL solo para ROOT
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])
  email           String    @unique
  name            String
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  // Identidad de plataforma (super-admin de Lynko). NO es un rol de tenant.
  isPlatformAdmin Boolean   @default(false)
  isActive        Boolean   @default(true)
  invitedAt       DateTime?
  passwordSetAt   DateTime?
  createdAt       DateTime  @default(now())

  orders               Order[]                  @relation("waiters")
  userBranches         UserBranch[]
  notificationEvents   NotificationEvent[]
  notificationPrefs    NotificationPreference[]
  webPushSubscriptions WebPushSubscription[]

  @@index([tenantId])
  @@index([roleId])
  @@map("users")
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique // "restaurant:menu:write"
  resource    String // "menu", "orders", "kitchen", "finance", ...
  action      String // "read", "write", "delete", "close"
  description String

  rolePermissions RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model Role {
  id        String   @id @default(cuid())
  tenantId  String? // NULL solo para ROOT
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  code      String // "ROOT", "OWNER", "MANAGER", "CASHIER", "WAITER", "KITCHEN", "ADMIN", o custom
  name      String // "Root", "Dueño", "Gerente", ...
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
  users           User[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserBranch {
  userId    String
  branchId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branches")
}

// ─── Menú ─────────────────────────────────────────────────────────────────────

model ProductCategory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  name      String
  emoji     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  products Product[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId])
  @@map("product_categories")
}

model Product {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  branchId        String?
  branch          Branch?         @relation(fields: [branchId], references: [id])
  categoryId      String
  category        ProductCategory @relation(fields: [categoryId], references: [id])
  name            String
  description     String?
  priceCOP        Int
  emoji           String?
  imageUrls       String[]
  isAvailable     Boolean         @default(true)
  sortOrder       Int             @default(0)
  targetMarginPct Float           @default(65)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  orderItems   OrderItem[]
  kitchenItems KitchenTicketItem[]
  recipeLines  RecipeLine[]
  priceHistory ProductPriceHistory[]

  @@index([tenantId])
  @@index([tenantId, branchId, deletedAt])
  @@index([categoryId])
  @@map("products")
}

// ─── Inventario ──────────────────────────────────────────────────────────────

model Ingredient {
  id                       String    @id @default(cuid())
  tenantId                 String
  tenant                   Tenant    @relation(fields: [tenantId], references: [id])
  branchId                 String
  branch                   Branch    @relation(fields: [branchId], references: [id])
  categoryId               String
  name                     String
  purchaseUnit             String
  recipeUnit               String
  // Cuántas unidades de receta trae 1 unidad de compra cuando NO hay conversión
  // física posible (ej: 1 paquete = 10 unidades). null = conversión automática
  // por dimensión (kg→g) o misma unidad.
  purchaseToRecipeFactor   Float?
  // Preparación (sub-receta): este "ingrediente" se produce a partir de otros
  // (ej: carne de birria). Su stock se crea produciendo tandas, no comprando.
  isPreparation            Boolean   @default(false)
  // Cuánto produce 1 tanda, en la unidad de compra/almacenamiento (ej: 5 kg).
  yieldQuantity            Float?
  grossStockQuantity       Float     @default(0)
  currentStock             Float     @default(0)
  netUsableQuantity        Float     @default(0)
  technicalWastePercentage Float     @default(0)
  totalPurchaseCost        Float     @default(0)
  grossUnitCost            Float     @default(0)
  netUnitCost              Float     @default(0)
  minStock                 Float     @default(0)
  supplierName             String?
  expirationDate           DateTime?
  notes                    String?
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  movements             StockMovement[]
  recipeLines           RecipeLine[]
  // Componentes de ESTA preparación (cuando isPreparation = true).
  preparationComponents PreparationComponent[] @relation("PreparationParent")
  // Preparaciones en las que este ingrediente se usa como componente.
  usedInPreparations    PreparationComponent[] @relation("PreparationComponent")

  @@unique([branchId, name])
  @@index([tenantId])
  @@index([branchId])
  @@index([categoryId])
  @@index([isActive])
  @@map("ingredients")
}

// Línea de sub-receta: un componente (ingrediente) que consume una preparación.
model PreparationComponent {
  id            String     @id @default(cuid())
  tenantId      String
  branchId      String
  preparationId String
  preparation   Ingredient @relation("PreparationParent", fields: [preparationId], references: [id], onDelete: Cascade)
  componentId   String
  component     Ingredient @relation("PreparationComponent", fields: [componentId], references: [id])
  quantity      Float
  unit          String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([preparationId, componentId])
  @@index([tenantId])
  @@index([branchId])
  @@index([componentId])
  @@map("preparation_components")
}

model StockMovement {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  branchId      String
  branch        Branch     @relation(fields: [branchId], references: [id])
  ingredientId  String
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])
  type          String
  quantity      Float
  unitCost      Float?
  previousStock Float
  newStock      Float
  orderId       String?
  notes         String?
  createdBy     String
  createdByName String?
  createdAt     DateTime   @default(now())

  @@index([tenantId])
  @@index([branchId, createdAt])
  @@index([ingredientId, createdAt])
  @@index([type])
  @@map("stock_movements")
}

model RecipeLine {
  id           String     @id @default(cuid())
  tenantId     String
  branchId     String
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Float
  unit         String
  // Merma por línea de receta (pérdida al preparar), aparte de la merma técnica del ingrediente.
  wastePercent Float      @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([productId, ingredientId])
  @@index([tenantId])
  @@index([branchId])
  @@index([ingredientId])
  @@map("recipe_lines")
}

// Histórico de precio/margen de un producto: cada cambio queda registrado con fecha.
// La app usa siempre el valor actual del producto; esto es sólo trazabilidad.
model ProductPriceHistory {
  id              String   @id @default(cuid())
  tenantId        String
  branchId        String?
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceCOP        Int
  targetMarginPct Float
  changedByUserId String?
  createdAt       DateTime @default(now())

  @@index([tenantId, productId, createdAt])
  @@map("product_price_history")
}

// ─── Carta pública ────────────────────────────────────────────────────────────

model MenuPublicConfig {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId           String?
  slug               String   @unique
  isPublished        Boolean  @default(false)
  showPrices         Boolean  @default(true)
  showDescription    Boolean  @default(true)
  showImages         Boolean  @default(true)
  showUnavailable    Boolean  @default(false)
  showFeaturedBadge  Boolean  @default(true)
  showRatings        Boolean  @default(false)
  showSavedCount     Boolean  @default(false)
  featuredProductIds String[] @default([])
  categoryOrder      String[] @default([])

  templateId          String  @default("minimal") // 'minimal' | 'cards' | 'magazine'
  primaryColor        String  @default("#16a34a")
  accentColor         String  @default("#0ea5e9")
  bannerText          String?
  logoMode            String? // 'tenant' | 'emoji' | 'image' | 'none'
  logoVariant         String? // 'center' | 'banner'
  logoFit             String? // 'contain' | 'cover'
  logoEmoji           String?
  logoImageUrl        String?
  bannerImageUrl      String?
  heroKicker          String?
  heroTitle           String?
  heroDescription     String?
  featuredTitle       String?
  featuredDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([branchId])
  @@map("menu_public_configs")
}

// ─── Áreas ────────────────────────────────────────────────────────────────────

model Area {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  name      String
  emoji     String?
  createdAt DateTime  @default(now())
  deletedAt DateTime? // soft-delete: null = activa, fecha = en papelera

  tables RestaurantTable[]

  @@unique([branchId, name])
  @@index([tenantId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("areas")
}

// ─── Mesas ────────────────────────────────────────────────────────────────────

model RestaurantTable {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  areaId    String?
  area      Area?     @relation(fields: [areaId], references: [id])
  code      String
  seats     Int
  shape     String    @default("SQUARE") // "SQUARE" | "RECTANGLE" | "ROUND"
  status    String    @default("AVAILABLE") // "AVAILABLE" | "PREPARING" | "ON_TABLE" | "PAYMENT" | "RESERVED" | "CLOSED"
  createdAt DateTime  @default(now())
  deletedAt DateTime? // soft-delete: null = activa, fecha = en papelera

  orders       Order[]
  reservations Reservation[]

  @@unique([branchId, code])
  @@index([branchId])
  @@index([deletedAt])
  @@map("restaurant_tables")
}

// ─── Órdenes ──────────────────────────────────────────────────────────────────

model Order {
  id         String          @id @default(cuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  branchId   String
  branch     Branch          @relation(fields: [branchId], references: [id])
  tableId    String
  table      RestaurantTable @relation(fields: [tableId], references: [id])
  terminalId String?
  waiterId   String?
  waiter     User?           @relation("waiters", fields: [waiterId], references: [id])
  status     String          @default("OPEN") // "OPEN" | "CLOSED"
  totalCOP   Int?
  // Costo de lo vendido, congelado al cerrar (suma de OrderItem.unitCostCOP*qty).
  // null = la orden es anterior al costeo o ningún ítem tenía receta. NUNCA 0
  // por defecto: 0 significaría "costó cero" e inflaría el margen.
  costCOP    Int?
  createdAt  DateTime        @default(now())
  closedAt   DateTime?

  items          OrderItem[]
  kitchenTickets KitchenTicket[]
  paymentSplits  PaymentSplit[]
  events         OrderEvent[]
  claims         OrderClaim[]

  @@index([tenantId])
  @@index([branchId, status])
  @@index([tenantId, branchId, status, createdAt])
  @@index([tenantId, branchId, status, closedAt])
  @@index([tenantId, branchId, tableId, status])
  @@index([tableId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  // Identidad de la línea. Permite el mismo producto en varias líneas con
  // distintas notas/opciones. El backend usa `lineKey ?? productId`.
  lineKey     String
  name        String
  priceCOP    Int
  // Costo de receta de UNA unidad, congelado al enviar a cocina (que es cuando
  // el insumo se consume de verdad). null = producto sin receta cargada.
  unitCostCOP Int?
  qty         Int
  sentQty     Int      @default(0)
  // Opciones/especificaciones del ítem (persistidas para orden + comanda).
  notes       String?
  additions   Json?
  modifiers   Json?
  addedAt     DateTime @default(now())

  @@unique([orderId, lineKey])
  @@index([orderId])
  @@map("order_items")
}

// ─── Kitchen ──────────────────────────────────────────────────────────────────

model KitchenTicket {
  id       String    @id @default(cuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  orderId  String
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status   String    @default("PENDING") // "PENDING" | "PREPARING" | "READY" | "SERVED"
  priority String    @default("normal") // "normal" | "urgent"
  sentAt   DateTime
  readyAt  DateTime?
  servedAt DateTime?

  items KitchenTicketItem[]

  @@index([tenantId])
  @@index([tenantId, status, priority, sentAt])
  @@index([status, priority])
  @@index([orderId])
  @@map("kitchen_tickets")
}

model KitchenTicketItem {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  lineKey   String
  name      String
  qty       Int
  // Opciones/especificaciones copiadas del OrderItem al enviar a cocina, para
  // que la comanda impresa muestre las notas de cada plato.
  notes     String?
  additions Json?
  modifiers Json?

  @@unique([ticketId, lineKey])
  @@map("kitchen_ticket_items")
}

// ─── Pagos ────────────────────────────────────────────────────────────────────

model PaymentSplit {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  orderId  String
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  totalCOP Int
  paidAt   DateTime @default(now())

  contributions PaymentContribution[]
  items         PaymentSplitItem[]

  @@index([tenantId])
  @@index([orderId])
  @@index([tenantId, paidAt])
  @@index([tenantId, orderId, paidAt])
  @@index([paidAt])
  @@map("payment_splits")
}

model PaymentContribution {
  id       String       @id @default(cuid())
  splitId  String
  split    PaymentSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  method   String // "cash" | "qr" | "transfer" | "card"
  amount   Int
  cardType String? // "credit" | "debit"

  cashReceived Int? // solo efectivo: con cuánto pagó el cliente
  cashChange   Int? // solo efectivo: vuelto entregado (cashReceived - amount)

  @@unique([splitId, method])
  @@map("payment_contributions")
}

model PaymentSplitItem {
  id          String       @id @default(cuid())
  splitId     String
  split       PaymentSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  productId   String
  name        String
  qty         Int
  priceCOP    Int
  // Copiado del OrderItem al cerrar. El split es la unidad de ingreso que lee
  // finanzas, así que el costo tiene que viajar con él. null = sin receta.
  unitCostCOP Int?

  @@unique([splitId, productId])
  @@map("payment_split_items")
}

// ─── Reservas ─────────────────────────────────────────────────────────────────

model Reservation {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  branchId     String
  branch       Branch          @relation(fields: [branchId], references: [id])
  tableId      String
  table        RestaurantTable @relation(fields: [tableId], references: [id])
  guestName    String?
  guestPhone   String?
  partySize    Int?
  scheduledAt  DateTime
  scheduledEnd DateTime?
  occasion     String? // "birthday" | "anniversary" | "business" | "graduation" | "other"
  occasionNote String?
  notes        String?
  status       String          @default("ACTIVE") // "ACTIVE" | "SEATED" | "CANCELLED"
  cancelReason String?
  seatedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([tenantId])
  @@index([branchId, status])
  @@index([tenantId, branchId, status, scheduledAt])
  @@index([tableId])
  @@index([scheduledAt])
  @@map("reservations")
}

// ─── Finance ──────────────────────────────────────────────────────────────────

model Expense {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  branchId    String
  branch      Branch           @relation(fields: [branchId], references: [id])
  category    String // categoría de egreso (payroll, rent, platform, utilities, supplies, ...)
  concept     String
  amountCOP   Int
  incurredAt  DateTime
  // Recurrencia: distingue gastos fijos/recurrentes de gastos únicos.
  frequency   ExpenseFrequency @default(ONE_TIME)
  isRecurring Boolean          @default(false)
  dueDate     DateTime? // próxima fecha de causación para recurrentes
  note        String?
  createdAt   DateTime         @default(now())

  @@index([tenantId])
  @@index([tenantId, branchId, incurredAt])
  @@index([branchId, incurredAt])
  @@index([category])
  @@map("expenses")
}

model Payroll {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  branchId      String
  branch        Branch       @relation(fields: [branchId], references: [id])
  userId        String?
  staffName     String
  role          String
  periodMonth   String // "YYYY-MM"
  payFrequency  PayFrequency @default(MONTHLY)
  grossCOP      Int // bruto por período de pago (base + bonos)
  netCOP        Int // neto por período de pago
  bonusesCOP    Int          @default(0)
  deductionsCOP Int          @default(0)
  paidAt        DateTime?
  createdAt     DateTime     @default(now())

  @@unique([branchId, userId, periodMonth])
  @@index([tenantId])
  @@index([branchId, periodMonth])
  @@map("payrolls")
}

enum PayFrequency {
  DAILY // diario
  WEEKLY // semanal
  BIWEEKLY // quincenal
  MONTHLY // mensual
}

enum ContractType {
  FIXED // valor fijo por período
  FIXED_PLUS_BONUS // fijo + bonificaciones
  HOURLY // por horas
  COMMISSION // por comisión (barber)
}

enum LedgerEntryType {
  PAYMENT // pago realizado
  ADVANCE // adelanto
  LOAN // préstamo
  BONUS // incentivo / abono
  DEDUCTION // descuento
}

enum PaymentMethod {
  CASH // efectivo
  TRANSFER // transferencia a cuenta registrada
}

enum ExpenseFrequency {
  ONE_TIME // único
  DAILY
  WEEKLY
  BIWEEKLY // quincenal
  MONTHLY
  ANNUAL
}

model FinanceGoal {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  periodMonth String // "YYYY-MM" (ancla del período; para semanal/quincenal es el mes de inicio)
  metric      String // "revenue" | "profit"
  targetCOP   Int
  // Tipo de período y rango explícito (para pacing semanal/quincenal/mensual).
  periodType  String    @default("MONTHLY") // "MONTHLY" | "WEEKLY" | "BIWEEKLY"
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([branchId, periodMonth, metric])
  @@index([tenantId])
  @@map("finance_goals")
}

// ─── Auditoría ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  resource   String
  resourceId String
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Bitácora de la orden (línea de tiempo) ───────────────────────────────────

model OrderEvent {
  id       String         @id @default(cuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  orderId  String
  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type     OrderEventType
  at       DateTime       @default(now())
  ticketId String? // KitchenTicket relacionado, si aplica
  note     String?
  metadata Json?

  @@index([tenantId])
  @@index([orderId])
  @@index([tenantId, type, at])
  @@index([orderId, at])
  @@map("order_events")
}

enum OrderEventType {
  OPENED
  ITEM_ADDED
  ITEM_UPDATED
  ITEM_REMOVED
  SENT_TO_KITCHEN
  KITCHEN_PREPARING
  KITCHEN_READY
  SERVED
  ALL_SERVED
  PAYMENT_REQUESTED
  PAYMENT_REGISTERED
  CLOSED
  CLAIM
  VOIDED
}

// ─── Reclamos del cliente ─────────────────────────────────────────────────────

model OrderClaim {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  severity    ClaimSeverity @default(MEDIUM)
  byUserId    String?
  byUserName  String?
  resolution  String?
  resolvedAt  DateTime?
  at          DateTime      @default(now())

  @@index([tenantId])
  @@index([orderId])
  @@map("order_claims")
}

enum ClaimSeverity {
  LOW
  MEDIUM
  HIGH
}

// ─── Impresoras ───────────────────────────────────────────────────────────────

model Printer {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  branchId   String
  branch     Branch            @relation(fields: [branchId], references: [id])
  name       String
  target     PrinterTarget
  connection PrinterConnection
  address    String?
  // Conexión LAN (impresora en el router). El agente local abre TCP a ipAddress:port.
  ipAddress  String?
  port       Int?              @default(9100)
  paperWidth Int               @default(80) // 58 | 80
  isActive   Boolean           @default(true)
  // Heartbeat del agente local: última vez que se confirmó alcanzable. null = nunca visto.
  lastSeenAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  jobs PrintJob[]

  @@index([tenantId, branchId])
  @@index([tenantId, branchId, target])
  @@index([tenantId, branchId, target, isActive])
  @@map("printers")
}

enum PrinterTarget {
  KITCHEN
  BAR
  CASHIER
  DEFAULT
}

enum PrinterConnection {
  USB
  NETWORK
  BLUETOOTH
  AGENT
}

// ─── Jobs de impresión ────────────────────────────────────────────────────────

model PrintJob {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  branchId        String
  branch          Branch            @relation(fields: [branchId], references: [id])
  printerId       String?
  printer         Printer?          @relation(fields: [printerId], references: [id])
  documentType    PrintDocumentType
  documentId      String // PrintDocument.id — idempotency key
  payload         Json // el PrintDocument serializado
  status          PrintJobStatus    @default(QUEUED)
  attempts        Int               @default(0)
  lastError       String?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  sentAt          DateTime?
  acknowledgedAt  DateTime?

  @@unique([tenantId, branchId, documentId])
  @@index([tenantId, branchId, status])
  @@index([tenantId, branchId, status, createdAt])
  @@map("print_jobs")
}

enum PrintDocumentType {
  KITCHEN_TICKET
  RECEIPT
  Z_REPORT
  X_REPORT
  EXPENSE_VOUCHER
}

enum PrintJobStatus {
  QUEUED
  SENT
  ACK
  FAILED
}

// ─── Recibo compartible (historial + página pública /r/[token]) ───────────────

model ReceiptShare {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  branchId  String
  orderId   String
  splitId   String?
  token     String    @unique
  payload   Json // PrintDocument del recibo (re-renderizable)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, branchId, orderId])
  @@map("receipt_shares")
}

// ─── Arqueo de caja ───────────────────────────────────────────────────────────

model CashSession {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  branchId       String
  branch         Branch            @relation(fields: [branchId], references: [id])
  terminalId     String
  status         CashSessionStatus @default(OPEN)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  openedByUserId String
  closedByUserId String?
  openingAmount  Int
  expectedAmount Int?
  countedAmount  Int?
  difference     Int?
  openingNote    String?
  closingNote    String?

  movements CashMovement[]

  @@index([tenantId, branchId, terminalId, status])
  @@map("cash_sessions")
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashMovement {
  id              String           @id @default(cuid())
  sessionId       String
  session         CashSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type            CashMovementType
  method          String // cash | card | transfer | qr (consistente con PaymentContribution.method)
  amount          Int // siempre positivo; el tipo define el signo
  reference       String?
  note            String?
  createdByUserId String
  createdAt       DateTime         @default(now())

  @@index([sessionId])
  @@index([type, reference])
  @@map("cash_movements")
}

enum CashMovementType {
  OPENING
  SALE
  REFUND
  EXPENSE
  WITHDRAWAL
  DEPOSIT
  TIP
  ADJUSTMENT
}

// ─── Notificaciones ──────────────────────────────────────────────────────────

model NotificationEvent {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  vertical      String?
  type          String
  channel       NotificationChannel @default(IN_APP)
  status        NotificationStatus  @default(PENDING)
  title         String
  body          String?
  recipient     Json?
  payload       Json                @default("{}")
  readAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  failureReason String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, userId, readAt, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([tenantId, status, channel, createdAt])
  @@map("notification_events")
}

model NotificationPreference {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vertical   String   @default("shared")
  type       String
  inApp      Boolean  @default(true)
  webPush    Boolean  @default(false)
  email      Boolean  @default(false)
  whatsapp   Boolean  @default(false)
  quietStart String?
  quietEnd   String?
  timezone   String   @default("America/Bogota")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, userId, vertical, type])
  @@index([tenantId, userId])
  @@index([tenantId, vertical, type])
  @@map("notification_preferences")
}

model WebPushSubscription {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint       String    @unique
  p256dh         String
  auth           String
  expirationTime DateTime?
  userAgent      String?
  deviceLabel    String?
  isActive       Boolean   @default(true)
  lastSeenAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, userId, isActive])
  @@index([tenantId, branchId, isActive])
  @@map("web_push_subscriptions")
}

enum NotificationChannel {
  IN_APP
  WEB_PUSH
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

// ─── Plataforma / Backoffice super-admin ──────────────────────────────────────
// Ver docs/BACKOFFICE_ARCHITECTURE.md §3.5 y §10.

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum BillingCycle {
  monthly
  yearly
}

// Suscripción comercial del tenant (plan + estado + ciclo + periodo).
// Es la fuente de verdad de billing; tenant.status es el estado operativo.
model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               String // "BASIC" | "PRO" | "PREMIUM" (consistente con Tenant.plan)
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(monthly)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  nextPaymentDueAt   DateTime?
  graceEndsAt        DateTime? // nextPaymentDueAt + ventana de gracia
  trialEndsAt        DateTime?
  canceledAt         DateTime?
  // priceCOP/priceUSD = precio VIGENTE (el que se cobra). Se mantienen como
  // fuente legacy y siempre reflejan agreedPrice*.
  priceCOP           Int?
  priceUSD           Int?
  // Términos comerciales: precio de lista vs precio pactado. El descuento es la
  // diferencia y NO es un gasto — es ingreso que se deja de percibir (§finanzas).
  listPriceCOP       Int?
  listPriceUSD       Int?
  agreedPriceCOP     Int?
  agreedPriceUSD     Int?
  discountReason     String? // 'cliente fundador', 'bono 2 meses', …
  discountApprovedBy String?
  provider           String             @default("manual") // 'manual' | 'stripe' | 'mercadopago'
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  payments SubscriptionPayment[]

  @@index([status])
  @@map("subscriptions")
}

// Histórico de pagos de suscripción (facturación manual MVP).
// Un pago cubre un periodo [periodStart, periodEnd]; si periodEnd es futuro y
// abarca varios ciclos, es un PAGO ANTICIPADO. Ver §3.6.
model SubscriptionPayment {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan            String // plan vigente al momento del pago
  // kind distingue plata que entró de cortesías que no entraron:
  //   'payment' → cobro real            (countsAsRevenue = true)
  //   'bonus'   → mes regalado/cortesía (countsAsRevenue = false, amount 0)
  //   'credit'  → nota crédito/ajuste   (countsAsRevenue = false)
  kind            String        @default("payment")
  countsAsRevenue Boolean       @default(true)
  // amount = plata efectivamente recibida (neto). officialPrice = precio de lista
  // del plan al momento del cobro; discountApplied = lo que se dejó de cobrar.
  // Invariante: officialPrice - discountApplied = amount.
  amount          Int
  officialPrice   Int?
  discountApplied Int           @default(0)
  discountReason  String?
  currency        String        @default("COP") // 'COP' | 'USD'
  billingCycle    BillingCycle  @default(monthly)
  periodStart     DateTime
  periodEnd       DateTime
  paidAt          DateTime      @default(now()) // fecha de caja: define en qué periodo suma
  method          String        @default("manual") // 'cash' | 'transfer' | 'card' | 'manual' | …
  reference       String?
  receiptUrl      String?
  note            String?
  extendsPeriod   Boolean       @default(true)
  createdByUserId String // platform admin que registró el pago
  createdAt       DateTime      @default(now())

  @@index([tenantId, paidAt])
  @@index([paidAt])
  @@index([subscriptionId])
  @@index([countsAsRevenue, paidAt])
  @@map("subscription_payments")
}

// Contactos de cobro del tenant (gestionados desde el backoffice super-admin).
// Teléfono / WhatsApp / correo para pagos manuales de suscripción.
model BillingContact {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  phone     String
  whatsapp  String?
  email     String?
  isPrimary Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("billing_contacts")
}

// Finanzas internas de la plataforma Lynko (NO tenant-scoped).
// Se usan en el backoffice super-admin para organizar gastos propios,
// metas comerciales y seguimiento financiero cross-tenant.
// Un PlatformExpense es SIEMPRE una salida de plata real en una fecha
// (incurredAt). Los gastos recurrentes se declaran una vez en
// PlatformRecurringExpense y generan aquí un registro por cada cobro, para que
// el acumulado histórico sea plata realmente gastada y no una proyección.
model PlatformExpense {
  id          String    @id @default(cuid())
  category    String // 'infra' | 'marketing' | 'payroll' | 'tools' | 'support' | 'taxes' | 'other'
  concept     String
  vendor      String? // 'Vercel', 'Namecheap', 'Meta Ads', …
  amount      Int
  currency    String    @default("COP") // 'COP' | 'USD'
  // 'one_time' = compra puntual · 'recurring' = cobro de un contrato recurrente
  kind        String    @default("one_time")
  // Periodo que cubre el gasto (dominio anual: 1 año). Solo informativo: el
  // gasto suma completo en incurredAt (base caja), no se prorratea.
  periodStart DateTime?
  periodEnd   DateTime?
  incurredAt  DateTime
  note        String?

  recurringExpenseId String?
  recurringExpense   PlatformRecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([incurredAt])
  @@index([incurredAt, currency])
  @@index([category, currency, incurredAt])
  @@index([category])
  @@index([recurringExpenseId])
  @@map("platform_expenses")
}

// Compromiso de gasto recurrente (infra, dominio, herramientas, ads).
// Define QUÉ se paga, CADA CUÁNTO y HASTA CUÁNDO; cada cobro efectivo se
// materializa como PlatformExpense vía generateDueRecurringExpenses().
model PlatformRecurringExpense {
  id         String  @id @default(cuid())
  category   String
  concept    String
  vendor     String?
  amount     Int
  currency   String  @default("COP")
  // 'monthly' | 'quarterly' | 'yearly' | 'weekly'
  recurrence String  @default("monthly")

  startsAt     DateTime
  endsAt       DateTime? // null = indefinido (hasta que se cancele)
  nextChargeAt DateTime // próxima fecha de cobro pendiente de generar
  lastChargeAt DateTime?
  isActive     Boolean   @default(true)
  // true = al abrir el backoffice se generan los cobros vencidos automáticamente
  autoGenerate Boolean   @default(true)

  note            String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  charges PlatformExpense[]

  @@index([isActive, nextChargeAt])
  @@index([category])
  @@map("platform_recurring_expenses")
}

model PlatformFinanceGoal {
  id              String   @id @default(cuid())
  periodMonth     String // "YYYY-MM"
  metric          String // 'revenue_cop' | 'profit_cop' | 'mrr_cop' | 'payments_count' | 'active_tenants'
  target          Int
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([periodMonth, metric])
  @@index([periodMonth])
  @@map("platform_finance_goals")
}

// Bitácora de toda mutación cross-tenant hecha desde el backoffice (§2).
model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String // 'tenant.status', 'subscription.suspend', 'user.disable', …
  targetType  String // 'tenant' | 'subscription' | 'user'
  targetId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

// ─── Mensajería de plataforma (super-admin → dueño del tenant) ────────────────
// Envío MANUAL de WhatsApp/correo desde el backoffice: recordatorios de pago,
// datos de pago, bienvenida. No hay scheduler: cada mensaje sale por un clic.
// Ver docs/PLATFORM_MESSAGING_PLAN.md.

enum PlatformMessageChannel {
  WHATSAPP
  EMAIL
}

enum PlatformMessageStatus {
  SENDING
  SENT
  FAILED
  SKIPPED // sin destinatario, canal caído o datos incompletos
}

// Plantillas editables desde la consola: cambiar el texto de un cobro no debe
// requerir deploy. `isSystem` marca las sembradas (no se borran, sí se editan).
model PlatformMessageTemplate {
  id          String                 @id @default(cuid())
  // Una misma clave tiene una plantilla por canal: el texto de WhatsApp y el
  // HTML del correo son distintos aunque digan lo mismo.
  key         String // 'payment_reminder', 'payment_details', …
  name        String
  description String?
  channel     PlatformMessageChannel
  subject     String? // solo EMAIL
  body        String // texto plano (WA) o HTML (EMAIL)
  bodyText    String? // fallback texto plano del email
  variables   String[] // detectadas al guardar, para pintar los chips en la UI
  isSystem    Boolean                @default(false)
  isActive    Boolean                @default(true)
  updatedBy   String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([key, channel])
  @@index([channel])
  @@map("platform_message_templates")
}

// Medios de pago de Lynko (Bre-B/Nu, Nequi, transferencia…). Se configuran una
// vez y los renderiza {{medios_pago}}: cambiar la llave no toca las plantillas.
model PlatformPaymentMethod {
  id           String   @id @default(cuid())
  kind         String // 'breb' | 'nequi' | 'bank_transfer' | 'link' | 'cash'
  label        String // 'Bre-B · Nu'
  holder       String? // titular de la cuenta
  reference    String? // la llave '@DCU963', el nº de cuenta o el link
  bank         String? // 'Nu Colombia'
  accountType  String? // 'ahorros' | 'corriente'
  document     String? // CC/NIT del titular
  instructions String?
  qrImageUrl   String? // QR subido con POST /assets/upload
  qrPdfUrl     String? // PDF oficial del QR, adjuntable al correo
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("platform_payment_methods")
}

// Historial de todo lo enviado. Guarda el texto EXACTO que salió: es la única
// forma de responder "¿ya le avisamos y qué le dijimos?" sin adivinar.
model PlatformMessage {
  id          String                 @id @default(cuid())
  tenantId    String?
  tenant      Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  templateKey String?
  channel     PlatformMessageChannel
  status      PlatformMessageStatus  @default(SENDING)
  to          String // E.164 o email, ya normalizado
  toName      String?
  subject     String?
  body        String // snapshot de lo enviado
  attachments Json? // [{ filename, url }]
  sentAt      DateTime?
  lastError   String?
  providerId  String? // id del proveedor (wa msg id / resend id)
  skipReason  String? // 'no_whatsapp' | 'no_email' | 'channel_offline' | 'missing_data'
  createdBy   String // platform admin que hizo clic
  meta        Json? // { dueAt, amountCOP, plan, daysToDue } para auditoría
  createdAt   DateTime               @default(now())

  // Reservados para cuando se automatice (plan §10): así no hay segunda
  // migración el día que se agreguen los jobs.
  jobKey       String?
  dedupeKey    String?   @unique
  scheduledFor DateTime?

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@map("platform_messages")
}

// Configuracion comercial global de plataforma (fila unica id = 'singleton').
// El precio comercial de los planes vive en USD; esta tasa deriva COP para la
// landing, backoffice y calculos financieros que necesiten equivalencias.
//
// La fuente de verdad de la tasa pasó a ser `PlatformRate` (con fecha efectiva e
// histórico). Esta fila se sigue escribiendo en la misma transacción para no
// romper lectores legacy, pero NO se lee para resolver la tasa vigente.
model PlatformPricingConfig {
  id           String   @id @default("singleton")
  usdToCopRate Int      @default(3650)
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("platform_pricing_config")
}

// ─── Tarifas con fecha efectiva (append-only) ─────────────────────────────────
//
// Estas dos tablas son INMUTABLES: editar un precio es insertar una fila nueva,
// nunca UPDATE ni DELETE. Así la trazabilidad queda garantizada por construcción
// y un cambio de tarifa solo puede correr hacia adelante.
//
// Precio vigente a una fecha D = la fila con el `effectiveFrom` más alto que sea
// <= D, para ese (verticalCode, planCode).

/// Precio de lista de un plan para un vertical, a partir de una fecha.
model PlanPrice {
  id            String   @id @default(cuid())
  verticalCode  String // 'restaurant' | 'barber' | 'retail'
  planCode      String // 'BASIC' | 'PRO' | 'PREMIUM'
  priceUSD      Int
  effectiveFrom DateTime
  note          String?
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([verticalCode, planCode, effectiveFrom])
  @@map("plan_prices")
}

/// Tasa USD→COP a partir de una fecha.
model PlatformRate {
  id            String   @id @default(cuid())
  usdToCopRate  Int
  effectiveFrom DateTime
  note          String?
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([effectiveFrom])
  @@map("platform_rates")
}

// Configuración global de mensajería (fila única id = 'singleton').
// El proveedor de correo se configura DESDE LA CONSOLA, no por variables de
// entorno: cambiar el remitente o rotar la API key no debe requerir un redeploy.
model PlatformMessagingSettings {
  id           String   @id @default("singleton")
  waEnabled    Boolean  @default(false)
  emailEnabled Boolean  @default(false)
  fromEmail    String?
  fromName     String?
  replyTo      String?
  // Secreto: NUNCA se devuelve por la API. El GET expone solo `hasApiKey` y los
  // últimos 4 caracteres, para que la UI pueda decir si está puesta sin filtrarla.
  resendApiKey String?
  signature    String?  @default("Equipo Lynko")
  updatedAt    DateTime @updatedAt

  @@map("platform_messaging_settings")
}

// ─── Compensación de staff / Nómina (agnóstico de vertical) ───────────────────
// staffId apunta a User.id (restaurante) o BarberStaff.id (barber) según `source`.
// Sin FK dura porque referencia dos tablas; se valida en el service.

model StaffCompensation {
  id                     String       @id @default(cuid())
  tenantId               String
  branchId               String?
  staffId                String
  source                 String // 'tenant_user' | 'specialist'
  contractType           ContractType
  payFrequency           PayFrequency
  baseAmount             Int          @default(0) // COP por período
  defaultBonuses         Int? // FIXED_PLUS_BONUS
  hourlyRate             Int? // HOURLY
  expectedHoursPerPeriod Int? // HOURLY
  commissionPercent      Int? // COMMISSION (0-100)
  notes                  String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@unique([tenantId, staffId])
  @@index([tenantId, branchId])
  @@map("staff_compensations")
}

model RoleCompensationTemplate {
  id                     String       @id @default(cuid())
  tenantId               String
  role                   String // 'OWNER' | ... | 'SPECIALIST' | custom
  contractType           ContractType
  payFrequency           PayFrequency
  baseAmount             Int          @default(0)
  defaultBonuses         Int?
  hourlyRate             Int?
  expectedHoursPerPeriod Int?
  commissionPercent      Int?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@unique([tenantId, role])
  @@map("role_compensation_templates")
}

// Sesión de WhatsApp (whatsapp-web.js RemoteAuth). El zip de credenciales
// (~30MB) vive en Supabase Storage, bucket privado: aquí queda solo el índice.
// Guardarlo como bytea reescribía 30MB de TOAST + WAL en cada backup periódico
// y agotaba el Disk IO budget del proyecto. Sobrevive redeploys y funciona
// igual en local/prod (no depende del filesystem del contenedor).
model WhatsappSession {
  clientId    String   @id // safeClientId(tenantId, branchId)
  tenantId    String
  branchId    String
  storagePath String? // objeto en el bucket privado: whatsapp-sessions/<clientId>.zip
  dataHash    String? // sha256 del zip subido; evita reescribir si no cambió
  phoneNumber String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([tenantId, branchId])
  @@map("whatsapp_sessions")
}

model StaffLedgerEntry {
  id           String          @id @default(cuid())
  tenantId     String
  branchId     String?
  staffId      String
  staffName    String // snapshot para histórico
  type         LedgerEntryType
  amount       Int // COP
  period       String // "YYYY-MM"
  // Solo aplica a PAYMENT/ADVANCE/LOAN (salida de dinero).
  method       PaymentMethod?
  accountLabel String? // cuenta usada en TRANSFER (ej. "Bancolombia ***1234", "Nequi 300...")
  // Rango que cubre este pago (opcional): "de qué fecha a qué fecha".
  coversFrom   DateTime?
  coversTo     DateTime?
  note         String?
  date         DateTime        @default(now())

  @@index([tenantId, staffId, period])
  @@map("staff_ledger_entries")
}

// ─── Retail ──────────────────────────────────────────────────────────────────
//
// [VERTICAL_RETAIL] Vertical independiente: no comparte tablas con restaurante
// (Product/Order) ni con barbería (BarberService/BarberAppointment). El modelo
// de negocio es distinto — stock por unidad, costo/margen por producto, venta de
// mostrador sin mesas ni agenda — así que tiene sus propias entidades.
//
// Lo que SÍ reutiliza (transversal, no del restaurante): Tenant, Branch, User,
// Role/Permission, Expense, Payroll, FinanceGoal, StaffCompensation, CashSession,
// AuditLog, Notification*, PublicSite y el bucket de assets.
//
// Scope: todas las entidades son branch-scoped (una tienda tiene su propio stock
// y su propia caja) con tenantId denormalizado para el filtro de aislamiento.

model RetailCategory {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  name      String
  emoji     String?
  sortOrder Int       @default(0)
  // Visible en el sitio público. Apagarla oculta la categoría sin borrar productos.
  isVisible Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products RetailProduct[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId, branchId, deletedAt])
  @@map("retail_categories")
}

model RetailProduct {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id])
  categoryId    String
  category      RetailCategory @relation(fields: [categoryId], references: [id])
  // Identificadores de retail: SKU interno y código de barras para el escáner.
  sku           String?
  barcode       String?
  brand         String?
  name          String
  description   String?
  // Costo de compra y precio de venta. El precio escrito es la fuente de verdad;
  // los % se guardan para poder recalcular y para el piso de negociación.
  costCOP       Int            @default(0)
  priceCOP      Int
  // % de ganancia sobre el precio con el que se sugirió `priceCOP`.
  saleMarginPct Float?
  // Piso de negociación: por debajo de este precio la venta pierde margen
  // aceptable. Solo lo ve/edita el admin, nunca el cajero.
  minPriceCOP   Int?
  minMarginPct  Float?
  emoji         String?
  imageUrls     String[]
  // trackStock=false para servicios (p.ej. "cambio de pantalla"): se venden sin descontar stock.
  trackStock    Boolean        @default(true)
  stock         Int            @default(0)
  minStock      Int            @default(0)
  // isActive = vendible en el POS. isPublished = visible en el sitio público.
  isActive      Boolean        @default(true)
  isPublished   Boolean        @default(true)
  sortOrder     Int            @default(0)
  // Atributos libres del producto (modelo compatible, capacidad...).
  attributes    Json?
  // Opciones de presentación que el cliente elige al pedir: color, talla, etc.
  // Cada grupo trae sus valores con copy propio y las fotos asociadas, así el
  // sitio público puede mostrar "Pijama color negro" y cambiar la galería al
  // elegir. Null / [] = el producto no ofrece opciones y no se muestra nada.
  // Es configuración de catálogo, no una matriz de variantes: el stock y el SKU
  // siguen siendo del producto (una variante con inventario propio sería otra
  // tabla y cambiaría POS, kardex y ventas).
  options       Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  movements     RetailStockMovement[]
  saleItems     RetailSaleItem[]
  purchaseItems RetailPurchaseItem[]

  @@unique([tenantId, branchId, sku])
  @@index([tenantId, branchId, deletedAt])
  @@index([categoryId])
  @@index([tenantId, barcode])
  @@map("retail_products")
}

enum RetailStockMovementType {
  INITIAL // carga inicial de inventario
  PURCHASE // compra a proveedor
  SALE // salida por venta
  RETURN // devolución del cliente (reingresa)
  ADJUSTMENT // ajuste manual de conteo
  LOSS // pérdida, daño o robo
}

model RetailStockMovement {
  id          String                  @id @default(cuid())
  tenantId    String
  tenant      Tenant                  @relation(fields: [tenantId], references: [id])
  branchId    String
  branch      Branch                  @relation(fields: [branchId], references: [id])
  productId   String
  product     RetailProduct           @relation(fields: [productId], references: [id])
  type        RetailStockMovementType
  // Firmado: positivo entra, negativo sale. Kardex auditable.
  quantity    Int
  stockAfter  Int
  unitCostCOP Int?
  reason      String?
  // Referencia al origen (id de venta, número de factura de compra...).
  reference   String?
  userId      String?
  createdAt   DateTime                @default(now())

  @@index([tenantId, branchId, createdAt])
  @@index([productId, createdAt])
  @@map("retail_stock_movements")
}

model RetailCustomer {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  branchId       String
  branch         Branch    @relation(fields: [branchId], references: [id])
  name           String
  phone          String?
  email          String?
  documentId     String?
  notes          String?
  // Agregados denormalizados para no recalcular el histórico en cada listado.
  totalSpentCOP  Int       @default(0)
  salesCount     Int       @default(0)
  lastPurchaseAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  sales RetailSale[]

  @@unique([tenantId, phone])
  @@index([tenantId, branchId, deletedAt])
  @@map("retail_customers")
}

enum RetailSaleStatus {
  COMPLETED
  VOIDED // anulada: revierte stock y deja de contar en finanzas
}

enum RetailPaymentMethod {
  CASH
  CARD
  TRANSFER
  MIXED
  OTHER
}

model RetailSale {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  branchId      String
  branch        Branch              @relation(fields: [branchId], references: [id])
  // Consecutivo legible por tienda (RS-000001) para el recibo.
  code          String
  customerId    String?
  customer      RetailCustomer?     @relation(fields: [customerId], references: [id])
  // Vendedor y caja abierta en el momento del cobro (sin FK: CashSession es transversal).
  userId        String?
  cashSessionId String?
  status        RetailSaleStatus    @default(COMPLETED)
  subtotalCOP   Int
  discountCOP   Int                 @default(0)
  totalCOP      Int
  // Costo de la mercancía vendida, congelado al momento de la venta → margen real.
  costCOP       Int                 @default(0)
  paymentMethod RetailPaymentMethod @default(CASH)
  receivedCOP   Int?
  changeCOP     Int?
  note          String?
  soldAt        DateTime            @default(now())
  voidedAt      DateTime?
  voidedReason  String?
  createdAt     DateTime            @default(now())

  items RetailSaleItem[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId, soldAt])
  @@index([tenantId, branchId, status, soldAt])
  @@index([customerId])
  @@map("retail_sales")
}

model RetailSaleItem {
  id           String        @id @default(cuid())
  saleId       String
  sale         RetailSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String
  product      RetailProduct @relation(fields: [productId], references: [id])
  // Snapshot: el recibo no debe cambiar si luego renombran o reprecian el producto.
  name         String
  sku          String?
  quantity     Int
  unitPriceCOP Int
  unitCostCOP  Int           @default(0)
  discountCOP  Int           @default(0)
  totalCOP     Int

  @@index([saleId])
  @@index([productId])
  @@map("retail_sale_items")
}

enum RetailPurchaseStatus {
  PENDING // apuntado: falta pedirlo al proveedor
  ORDERED // ya se hizo el pedido, se espera que llegue
  RECEIVED // llegó a la tienda
  CANCELLED // ya no se va a pedir
}

/**
 * Lista de pedidos al proveedor: el paso previo al catálogo y al inventario.
 * Es una lista de tareas, no un documento contable. Se apunta lo que hace falta
 * ("20 pijamas beige"), se marca cuando se pidió y se marca cuando llegó; cada
 * marca deja su fecha, así se sabe cuánto lleva un pedido sin hacerse o sin
 * llegar. Recién al recibir se toca el inventario, y siempre por el kardex.
 * `productId` es opcional a propósito: se apunta mercancía que todavía no
 * existe en el catálogo (por eso es el paso *previo*). Cuando sí está enlazado,
 * recibirlo puede generar el movimiento PURCHASE del inventario.
 */
model RetailPurchaseItem {
  id               String               @id @default(cuid())
  tenantId         String
  tenant           Tenant               @relation(fields: [tenantId], references: [id])
  branchId         String
  branch           Branch               @relation(fields: [branchId], references: [id])
  // Enlace opcional al catálogo: null = todavía no es un producto de la tienda.
  productId        String?
  product          RetailProduct?       @relation(fields: [productId], references: [id])
  // Lo que se apunta. Con producto enlazado arranca con su nombre, pero se
  // puede editar: "pijamas beige talla M" describe mejor el pedido.
  name             String
  quantity         Int                  @default(1)
  // Unidad de compra tal como se le pide al proveedor (cajas, docenas, pares).
  unit             String?
  supplier         String?
  // Costo unitario estimado al apuntarlo; al recibir se confirma y va al kardex.
  estimatedCostCOP Int?
  note             String?
  status           RetailPurchaseStatus @default(PENDING)
  // Prioridad simple para ordenar la lista: lo urgente primero.
  isUrgent         Boolean              @default(false)

  // Fechas de cada marca: sin ellas la lista no dice si algo está atascado.
  createdAt  DateTime  @default(now())
  orderedAt  DateTime?
  receivedAt DateTime?
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  // Quién marcó cada paso (sin FK: User es transversal a las verticales).
  createdById     String?
  orderedById     String?
  receivedById    String?
  // Movimiento de inventario generado al recibir, si se enlazó al catálogo.
  stockMovementId String?

  @@index([tenantId, branchId, status, deletedAt])
  @@index([tenantId, branchId, createdAt])
  @@index([productId])
  @@map("retail_purchase_items")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Multi-tenancy Core ───────────────────────────────────────────────────────

model Tenant {
  id               String            @id
  name             String
  plan             String            @default("BASIC") // "BASIC" | "PRO" | "PREMIUM"
  verticalId       String?
  vertical         BusinessVertical? @relation(fields: [verticalId], references: [id])
  planId           String?
  planRef          SubscriptionPlan? @relation(fields: [planId], references: [id])
  // Estado operativo de la cuenta (controla el acceso a la app del tenant).
  status           TenantStatus      @default(ACTIVE)
  // Overrides de features por tenant (espeja Tenant.featureOverrides del FE).
  // Pisan el default del plan. null = sin overrides (hereda del plan).
  featureOverrides Json?
  // Suscripción comercial vigente (entidad propia).
  subscription     Subscription?
  subscriptionPayments SubscriptionPayment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  users                User[]
  branches             Branch[]
  products             Product[]
  categories           ProductCategory[]
  ingredients          Ingredient[]
  stockMovements       StockMovement[]
  menuPublicConfig     MenuPublicConfig?
  areas                Area[]
  tables               RestaurantTable[]
  orders               Order[]
  kitchenTickets       KitchenTicket[]
  paymentSplits        PaymentSplit[]
  reservations         Reservation[]
  expenses             Expense[]
  payrolls             Payroll[]
  financeGoals         FinanceGoal[]
  roles                Role[]
  barberSettings       BarberSettings[]
  barberServices       BarberService[]
  barberStaff          BarberStaff[]
  barberCustomers      BarberCustomer[]
  barberAppointments   BarberAppointment[]
  publicSites          PublicSite[]
  orderEvents          OrderEvent[]
  orderClaims          OrderClaim[]
  printers             Printer[]
  printJobs            PrintJob[]
  receiptShares        ReceiptShare[]
  cashSessions         CashSession[]
  notificationEvents   NotificationEvent[]
  notificationPrefs    NotificationPreference[]
  webPushSubscriptions WebPushSubscription[]

  @@index([plan])
  @@index([verticalId])
  @@index([planId])
  @@map("tenants")
}

model BusinessVertical {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants Tenant[]
  plans   VerticalPlan[]

  @@index([isActive])
  @@map("business_verticals")
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  priceCOP    Int      @default(0)
  currency    String   @default("COP")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants   Tenant[]
  verticals VerticalPlan[]

  @@index([isActive])
  @@map("subscription_plans")
}

model VerticalPlan {
  verticalId String
  planId     String
  isActive   Boolean @default(true)

  vertical BusinessVertical @relation(fields: [verticalId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([verticalId, planId])
  @@index([planId])
  @@index([isActive])
  @@map("vertical_plans")
}

model Branch {
  id        String   @id
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  address   String?
  createdAt DateTime @default(now())

  products             Product[]
  categories           ProductCategory[]
  ingredients          Ingredient[]
  stockMovements       StockMovement[]
  areas                Area[]
  tables               RestaurantTable[]
  orders               Order[]
  reservations         Reservation[]
  expenses             Expense[]
  payrolls             Payroll[]
  financeGoals         FinanceGoal[]
  userBranches         UserBranch[]
  barberSettings       BarberSettings?
  barberServices       BarberService[]
  barberStaff          BarberStaff[]
  barberCustomers      BarberCustomer[]
  barberAppointments   BarberAppointment[]
  publicSites          PublicSite[]
  printers             Printer[]
  printJobs            PrintJob[]
  cashSessions         CashSession[]
  notificationEvents   NotificationEvent[]
  webPushSubscriptions WebPushSubscription[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("branches")
}

// ─── Barberia ────────────────────────────────────────────────────────────────

model BarberSettings {
  id                     String   @id @default(cuid())
  tenantId               String
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId               String
  branch                 Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  phone                  String?
  city                   String?
  neighborhood           String?
  whatsapp               String?
  timezone               String   @default("America/Bogota")
  currency               String   @default("COP")
  logoUrl                String?
  bookingSlug            String   @unique
  bookingMode            String   @default("services")
  businessHours          Json     @default("{}")
  onlineBookingEnabled   Boolean  @default(true)
  publicProfilePublished Boolean  @default(true)
  whatsappEnabled        Boolean  @default(false)
  loyaltyEnabled         Boolean  @default(false)
  themeTemplateId        String   @default("studio")
  themePrimaryColor      String   @default("#6366f1")
  themeAccentColor       String   @default("#22c55e")
  themeInkColor          String   @default("#0f172a")
  themeLogoMode          String?  @default("initials")
  themeLogoImageUrl      String?
  themeBannerImageUrl    String?
  heroImageUrl           String?
  heroTitle              String?
  heroDescription        String?
  shortName              String?
  tagline                String?
  eyebrow                String?
  description            String?
  highlights             String[] @default([])
  stats                  Json     @default("[]")
  galleryImages          Json     @default("[]")
  socialInstagram        String?
  socialFacebook         String?
  socialTiktok           String?
  socialWebsite          String?
  instagramProfileUrl    String?
  instagramPosts         String[] @default([])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([branchId])
  @@index([tenantId])
  @@map("barber_settings")
}

model PublicSite {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId          String
  branch            Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  slug              String    @unique
  publishedSlug     String?
  status            String    @default("draft")
  vertical          String    @default("barber")
  publishedAt       DateTime?
  publishedByUserId String?
  draftPayload      Json      @default("{}")
  publishedPayload  Json?

  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?

  themePrimary        String  @default("#6366f1")
  themeAccent         String  @default("#22c55e")
  themeInk            String  @default("#0f172a")
  themeBackground     String  @default("#ffffff")
  themeSurface        String  @default("#f8fafc")
  themeRadius         String  @default("md")
  themeSecondary      String?
  themeMode           String?
  themeBackgroundType String?
  themeFontStyle      String?
  themeLogoUrl        String?
  themeFaviconUrl     String?
  themeWhatsapp       Json?

  shortName    String?
  neighborhood String?
  city         String?
  phone        String?
  whatsapp     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections       PublicSiteSection[]
  assets         PublicSiteAsset[]
  socialLinks    PublicSiteSocialLink[]
  instagramPosts PublicSiteInstagramPost[]
  stats          PublicSiteStat[]
  highlights     PublicSiteHighlight[]

  @@unique([branchId])
  @@index([tenantId])
  @@index([branchId, status])
  @@index([slug, status])
  @@map("public_sites")
}

model PublicSiteSection {
  id        String     @id @default(cuid())
  siteId    String
  site      PublicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type      String
  isVisible Boolean    @default(true)
  sortOrder Int        @default(0)
  width     String     @default("contained")
  density   String     @default("comfortable")

  title     String?
  eyebrow   String?
  subtitle  String?
  body      String?
  ctaLabel  String?
  ctaAction String?
  ctaHref   String?
  assetIds  String[] @default([])
  settings  Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, sortOrder])
  @@index([siteId, type])
  @@map("public_site_sections")
}

model PublicSiteAsset {
  id         String     @id @default(cuid())
  siteId     String
  site       PublicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  kind       String
  url        String
  path       String?
  bucket     String?
  alt        String
  width      Int?
  height     Int?
  fit        String     @default("cover")
  focalPoint String     @default("center")
  isVisible  Boolean    @default(true)
  sortOrder  Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, kind])
  @@index([siteId, sortOrder])
  @@map("public_site_assets")
}

model PublicSiteSocialLink {
  id        String     @id @default(cuid())
  siteId    String
  site      PublicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  provider  String
  label     String
  url       String
  isVisible Boolean    @default(true)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, provider])
  @@index([siteId, sortOrder])
  @@map("public_site_social_links")
}

model PublicSiteInstagramPost {
  id        String     @id @default(cuid())
  siteId    String
  site      PublicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url       String
  kind      String
  isVisible Boolean    @default(true)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, sortOrder])
  @@map("public_site_instagram_posts")
}

model PublicSiteStat {
  id        String     @id @default(cuid())
  siteId    String
  site      PublicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  label     String
  value     String
  isVisible Boolean    @default(true)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, sortOrder])
  @@map("public_site_stats")
}

model PublicSiteHighlight {
  id        String     @id @default(cuid())
  siteId    String
  site      PublicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  label     String
  isVisible Boolean    @default(true)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, sortOrder])
  @@map("public_site_highlights")
}

model BarberService {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  durationMin     Int
  priceCOP        Int
  // Modo recursos: bloques de reserva adicionales al base (1h = priceCOP).
  // [{ minutes: number, priceCOP?: number | null }]. priceCOP null = derivado.
  durationOptions Json     @default("[]")
  color           String?
  imageUrls       String[] @default([])
  category        String?
  resultDuration  String?
  retouchPriceCOP Int?
  retouchNote     String?
  primaryImageUrl String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staffServices BarberStaffService[]
  appointments  BarberAppointment[]
  assets        BarberServiceAsset[]

  @@unique([branchId, name])
  @@index([tenantId])
  @@index([branchId, isActive])
  @@index([category])
  @@map("barber_services")
}

model BarberServiceAsset {
  id                  String        @id @default(cuid())
  tenantId            String
  serviceId           String
  service             BarberService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  url                 String
  alt                 String?
  kind                String        @default("gallery") // "primary" | "gallery" | "before" | "after"
  fit                 String        @default("cover") // "cover" | "contain"
  focalPoint          String        @default("center") // "center" | "top" | "bottom" | "left" | "right"
  showInPublicGallery Boolean       @default(true)
  sortOrder           Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([tenantId])
  @@index([serviceId, sortOrder])
  @@index([serviceId, kind])
  @@map("barber_service_assets")
}

model BarberStaff {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId    String?
  name      String
  email     String?
  phone     String?
  avatarUrl String?
  color     String?
  bio       String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services     BarberStaffService[]
  appointments BarberAppointment[]

  @@unique([branchId, name])
  @@index([tenantId])
  @@index([branchId, isActive])
  @@map("barber_staff")
}

model BarberStaffService {
  staffId   String
  serviceId String
  staff     BarberStaff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   BarberService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([staffId, serviceId])
  @@index([serviceId])
  @@map("barber_staff_services")
}

model BarberCustomer {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  email       String?
  notes       String?
  tags        String[]  @default([])
  totalVisits Int       @default(0)
  lastVisitAt DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  appointments BarberAppointment[]

  @@unique([branchId, phone])
  @@index([tenantId])
  @@index([branchId, name])
  @@map("barber_customers")
}

model BarberAppointment {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId   String
  customer     BarberCustomer @relation(fields: [customerId], references: [id])
  serviceId    String
  service      BarberService  @relation(fields: [serviceId], references: [id])
  staffId      String?
  staff        BarberStaff?   @relation(fields: [staffId], references: [id])
  scheduledAt  DateTime
  scheduledEnd DateTime
  status       String         @default("SCHEDULED")
  source       String         @default("manual")
  notes        String?
  cancelReason String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([tenantId])
  @@index([branchId, status])
  @@index([staffId, scheduledAt])
  @@index([customerId, scheduledAt])
  @@map("barber_appointments")
}

// ─── Users & RBAC ────────────────────────────────────────────────────────────

model User {
  id            String    @id // mapea a auth.users.id de Supabase (UUID)
  tenantId      String? // NULL solo para ROOT
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  email         String    @unique
  name          String
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  // Identidad de plataforma (super-admin de Lynko). NO es un rol de tenant.
  isPlatformAdmin Boolean @default(false)
  isActive      Boolean   @default(true)
  invitedAt     DateTime?
  passwordSetAt DateTime?
  createdAt     DateTime  @default(now())

  orders               Order[]                  @relation("waiters")
  userBranches         UserBranch[]
  notificationEvents   NotificationEvent[]
  notificationPrefs    NotificationPreference[]
  webPushSubscriptions WebPushSubscription[]

  @@index([tenantId])
  @@index([roleId])
  @@map("users")
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique // "restaurant:menu:write"
  resource    String // "menu", "orders", "kitchen", "finance", ...
  action      String // "read", "write", "delete", "close"
  description String

  rolePermissions RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model Role {
  id        String   @id @default(cuid())
  tenantId  String? // NULL solo para ROOT
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  code      String // "ROOT", "OWNER", "MANAGER", "CASHIER", "WAITER", "KITCHEN", "ADMIN", o custom
  name      String // "Root", "Dueño", "Gerente", ...
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
  users           User[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserBranch {
  userId    String
  branchId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branches")
}

// ─── Menú ─────────────────────────────────────────────────────────────────────

model ProductCategory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  name      String
  emoji     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  products Product[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId])
  @@map("product_categories")
}

model Product {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  branchId        String?
  branch          Branch?         @relation(fields: [branchId], references: [id])
  categoryId      String
  category        ProductCategory @relation(fields: [categoryId], references: [id])
  name            String
  description     String?
  priceCOP        Int
  emoji           String?
  imageUrls       String[]
  isAvailable     Boolean         @default(true)
  sortOrder       Int             @default(0)
  targetMarginPct Int             @default(65)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  orderItems   OrderItem[]
  kitchenItems KitchenTicketItem[]
  recipeLines  RecipeLine[]

  @@index([tenantId])
  @@index([tenantId, branchId, deletedAt])
  @@index([categoryId])
  @@map("products")
}

// ─── Inventario ──────────────────────────────────────────────────────────────

model Ingredient {
  id                       String    @id @default(cuid())
  tenantId                 String
  tenant                   Tenant    @relation(fields: [tenantId], references: [id])
  branchId                 String
  branch                   Branch    @relation(fields: [branchId], references: [id])
  categoryId               String
  name                     String
  purchaseUnit             String
  recipeUnit               String
  grossStockQuantity       Float     @default(0)
  currentStock             Float     @default(0)
  netUsableQuantity        Float     @default(0)
  technicalWastePercentage Float     @default(0)
  totalPurchaseCost        Float     @default(0)
  grossUnitCost            Float     @default(0)
  netUnitCost              Float     @default(0)
  minStock                 Float     @default(0)
  supplierName             String?
  expirationDate           DateTime?
  notes                    String?
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  movements   StockMovement[]
  recipeLines RecipeLine[]

  @@unique([branchId, name])
  @@index([tenantId])
  @@index([branchId])
  @@index([categoryId])
  @@index([isActive])
  @@map("ingredients")
}

model StockMovement {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  branchId      String
  branch        Branch     @relation(fields: [branchId], references: [id])
  ingredientId  String
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])
  type          String
  quantity      Float
  unitCost      Float?
  previousStock Float
  newStock      Float
  orderId       String?
  notes         String?
  createdBy     String
  createdByName String?
  createdAt     DateTime   @default(now())

  @@index([tenantId])
  @@index([branchId, createdAt])
  @@index([ingredientId, createdAt])
  @@index([type])
  @@map("stock_movements")
}

model RecipeLine {
  id           String     @id @default(cuid())
  tenantId     String
  branchId     String
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Float
  unit         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([productId, ingredientId])
  @@index([tenantId])
  @@index([branchId])
  @@index([ingredientId])
  @@map("recipe_lines")
}

// ─── Carta pública ────────────────────────────────────────────────────────────

model MenuPublicConfig {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId           String?
  slug               String   @unique
  isPublished        Boolean  @default(false)
  showPrices         Boolean  @default(true)
  showDescription    Boolean  @default(true)
  showImages         Boolean  @default(true)
  showUnavailable    Boolean  @default(false)
  showFeaturedBadge  Boolean  @default(true)
  showRatings        Boolean  @default(false)
  showSavedCount     Boolean  @default(false)
  featuredProductIds String[] @default([])
  categoryOrder      String[] @default([])

  templateId          String  @default("minimal") // 'minimal' | 'cards' | 'magazine'
  primaryColor        String  @default("#16a34a")
  accentColor         String  @default("#0ea5e9")
  bannerText          String?
  logoMode            String? // 'tenant' | 'emoji' | 'image' | 'none'
  logoVariant         String? // 'center' | 'banner'
  logoFit             String? // 'contain' | 'cover'
  logoEmoji           String?
  logoImageUrl        String?
  bannerImageUrl      String?
  heroKicker          String?
  heroTitle           String?
  heroDescription     String?
  featuredTitle       String?
  featuredDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([branchId])
  @@map("menu_public_configs")
}

// ─── Áreas ────────────────────────────────────────────────────────────────────

model Area {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  name      String
  emoji     String?
  createdAt DateTime  @default(now())
  deletedAt DateTime? // soft-delete: null = activa, fecha = en papelera

  tables RestaurantTable[]

  @@unique([branchId, name])
  @@index([tenantId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("areas")
}

// ─── Mesas ────────────────────────────────────────────────────────────────────

model RestaurantTable {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id])
  code      String
  seats     Int
  shape     String    @default("SQUARE") // "SQUARE" | "RECTANGLE" | "ROUND"
  status    String    @default("AVAILABLE") // "AVAILABLE" | "PREPARING" | "ON_TABLE" | "PAYMENT" | "RESERVED" | "CLOSED"
  createdAt DateTime  @default(now())
  deletedAt DateTime? // soft-delete: null = activa, fecha = en papelera

  orders       Order[]
  reservations Reservation[]

  @@unique([branchId, code])
  @@index([branchId])
  @@index([deletedAt])
  @@map("restaurant_tables")
}

// ─── Órdenes ──────────────────────────────────────────────────────────────────

model Order {
  id         String          @id @default(cuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  branchId   String
  branch     Branch          @relation(fields: [branchId], references: [id])
  tableId    String
  table      RestaurantTable @relation(fields: [tableId], references: [id])
  terminalId String?
  waiterId   String?
  waiter     User?           @relation("waiters", fields: [waiterId], references: [id])
  status     String          @default("OPEN") // "OPEN" | "CLOSED"
  totalCOP   Int?
  createdAt  DateTime        @default(now())
  closedAt   DateTime?

  items          OrderItem[]
  kitchenTickets KitchenTicket[]
  paymentSplits  PaymentSplit[]
  events         OrderEvent[]
  claims         OrderClaim[]

  @@index([tenantId])
  @@index([branchId, status])
  @@index([tenantId, branchId, status, createdAt])
  @@index([tenantId, branchId, status, closedAt])
  @@index([tenantId, branchId, tableId, status])
  @@index([tableId])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  name      String
  priceCOP  Int
  qty       Int
  sentQty   Int      @default(0)
  addedAt   DateTime @default(now())

  @@unique([orderId, productId])
  @@index([orderId])
  @@map("order_items")
}

// ─── Kitchen ──────────────────────────────────────────────────────────────────

model KitchenTicket {
  id       String    @id @default(cuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  orderId  String
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status   String    @default("PENDING") // "PENDING" | "PREPARING" | "READY" | "SERVED"
  priority String    @default("normal") // "normal" | "urgent"
  sentAt   DateTime
  readyAt  DateTime?
  servedAt DateTime?

  items KitchenTicketItem[]

  @@index([tenantId])
  @@index([tenantId, status, priority, sentAt])
  @@index([status, priority])
  @@index([orderId])
  @@map("kitchen_tickets")
}

model KitchenTicketItem {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  name      String
  qty       Int

  @@unique([ticketId, productId])
  @@map("kitchen_ticket_items")
}

// ─── Pagos ────────────────────────────────────────────────────────────────────

model PaymentSplit {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  orderId  String
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  totalCOP Int
  paidAt   DateTime @default(now())

  contributions PaymentContribution[]
  items         PaymentSplitItem[]

  @@index([tenantId])
  @@index([orderId])
  @@index([tenantId, paidAt])
  @@index([tenantId, orderId, paidAt])
  @@index([paidAt])
  @@map("payment_splits")
}

model PaymentContribution {
  id       String       @id @default(cuid())
  splitId  String
  split    PaymentSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  method   String // "cash" | "qr" | "transfer" | "card"
  amount   Int
  cardType String? // "credit" | "debit"

  @@unique([splitId, method])
  @@map("payment_contributions")
}

model PaymentSplitItem {
  id        String       @id @default(cuid())
  splitId   String
  split     PaymentSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  productId String
  name      String
  qty       Int
  priceCOP  Int

  @@unique([splitId, productId])
  @@map("payment_split_items")
}

// ─── Reservas ─────────────────────────────────────────────────────────────────

model Reservation {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  branchId     String
  branch       Branch          @relation(fields: [branchId], references: [id])
  tableId      String
  table        RestaurantTable @relation(fields: [tableId], references: [id])
  guestName    String?
  guestPhone   String?
  partySize    Int?
  scheduledAt  DateTime
  scheduledEnd DateTime?
  occasion     String? // "birthday" | "anniversary" | "business" | "graduation" | "other"
  occasionNote String?
  notes        String?
  status       String          @default("ACTIVE") // "ACTIVE" | "SEATED" | "CANCELLED"
  cancelReason String?
  seatedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([tenantId])
  @@index([branchId, status])
  @@index([tenantId, branchId, status, scheduledAt])
  @@index([tableId])
  @@index([scheduledAt])
  @@map("reservations")
}

// ─── Finance ──────────────────────────────────────────────────────────────────

model Expense {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  category   String // "rent" | "utilities" | "supplies" | "marketing" | "other"
  concept    String
  amountCOP  Int
  incurredAt DateTime
  note       String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, branchId, incurredAt])
  @@index([branchId, incurredAt])
  @@index([category])
  @@map("expenses")
}

model Payroll {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  userId      String?
  staffName   String
  role        String
  periodMonth String // "YYYY-MM"
  grossCOP    Int
  netCOP      Int
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@unique([branchId, userId, periodMonth])
  @@index([tenantId])
  @@index([branchId, periodMonth])
  @@map("payrolls")
}

model FinanceGoal {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  periodMonth String // "YYYY-MM"
  metric      String // "revenue" | "profit"
  targetCOP   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([branchId, periodMonth, metric])
  @@index([tenantId])
  @@map("finance_goals")
}

// ─── Auditoría ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  resource   String
  resourceId String
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Bitácora de la orden (línea de tiempo) ───────────────────────────────────

model OrderEvent {
  id       String         @id @default(cuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  orderId  String
  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type     OrderEventType
  at       DateTime       @default(now())
  ticketId String? // KitchenTicket relacionado, si aplica
  note     String?
  metadata Json?

  @@index([tenantId])
  @@index([orderId])
  @@index([tenantId, type, at])
  @@index([orderId, at])
  @@map("order_events")
}

enum OrderEventType {
  OPENED
  ITEM_ADDED
  ITEM_UPDATED
  ITEM_REMOVED
  SENT_TO_KITCHEN
  KITCHEN_PREPARING
  KITCHEN_READY
  SERVED
  ALL_SERVED
  PAYMENT_REQUESTED
  PAYMENT_REGISTERED
  CLOSED
  CLAIM
}

// ─── Reclamos del cliente ─────────────────────────────────────────────────────

model OrderClaim {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  severity    ClaimSeverity @default(MEDIUM)
  byUserId    String?
  byUserName  String?
  resolution  String?
  resolvedAt  DateTime?
  at          DateTime      @default(now())

  @@index([tenantId])
  @@index([orderId])
  @@map("order_claims")
}

enum ClaimSeverity {
  LOW
  MEDIUM
  HIGH
}

// ─── Impresoras ───────────────────────────────────────────────────────────────

model Printer {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  branchId   String
  branch     Branch            @relation(fields: [branchId], references: [id])
  name       String
  target     PrinterTarget
  connection PrinterConnection
  address    String?
  paperWidth Int               @default(80) // 58 | 80
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  jobs PrintJob[]

  @@index([tenantId, branchId])
  @@index([tenantId, branchId, target])
  @@index([tenantId, branchId, target, isActive])
  @@map("printers")
}

enum PrinterTarget {
  KITCHEN
  BAR
  CASHIER
  DEFAULT
}

enum PrinterConnection {
  USB
  NETWORK
  BLUETOOTH
  AGENT
}

// ─── Jobs de impresión ────────────────────────────────────────────────────────

model PrintJob {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  branchId        String
  branch          Branch            @relation(fields: [branchId], references: [id])
  printerId       String?
  printer         Printer?          @relation(fields: [printerId], references: [id])
  documentType    PrintDocumentType
  documentId      String // PrintDocument.id — idempotency key
  payload         Json // el PrintDocument serializado
  status          PrintJobStatus    @default(QUEUED)
  attempts        Int               @default(0)
  lastError       String?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  sentAt          DateTime?
  acknowledgedAt  DateTime?

  @@unique([tenantId, branchId, documentId])
  @@index([tenantId, branchId, status])
  @@index([tenantId, branchId, status, createdAt])
  @@map("print_jobs")
}

enum PrintDocumentType {
  KITCHEN_TICKET
  RECEIPT
  Z_REPORT
  X_REPORT
  EXPENSE_VOUCHER
}

enum PrintJobStatus {
  QUEUED
  SENT
  ACK
  FAILED
}

// ─── Recibo compartible (historial + página pública /r/[token]) ───────────────

model ReceiptShare {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  branchId  String
  orderId   String
  splitId   String?
  token     String    @unique
  payload   Json // PrintDocument del recibo (re-renderizable)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, branchId, orderId])
  @@map("receipt_shares")
}

// ─── Arqueo de caja ───────────────────────────────────────────────────────────

model CashSession {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  branchId       String
  branch         Branch            @relation(fields: [branchId], references: [id])
  terminalId     String
  status         CashSessionStatus @default(OPEN)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  openedByUserId String
  closedByUserId String?
  openingAmount  Int
  expectedAmount Int?
  countedAmount  Int?
  difference     Int?
  openingNote    String?
  closingNote    String?

  movements CashMovement[]

  @@index([tenantId, branchId, terminalId, status])
  @@map("cash_sessions")
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashMovement {
  id              String           @id @default(cuid())
  sessionId       String
  session         CashSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type            CashMovementType
  method          String // cash | card | transfer | qr (consistente con PaymentContribution.method)
  amount          Int // siempre positivo; el tipo define el signo
  reference       String?
  note            String?
  createdByUserId String
  createdAt       DateTime         @default(now())

  @@index([sessionId])
  @@index([type, reference])
  @@map("cash_movements")
}

enum CashMovementType {
  OPENING
  SALE
  REFUND
  EXPENSE
  WITHDRAWAL
  DEPOSIT
  TIP
  ADJUSTMENT
}

// ─── Notificaciones ──────────────────────────────────────────────────────────

model NotificationEvent {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  vertical      String?
  type          String
  channel       NotificationChannel @default(IN_APP)
  status        NotificationStatus  @default(PENDING)
  title         String
  body          String?
  recipient     Json?
  payload       Json                @default("{}")
  readAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  failureReason String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, userId, readAt, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([tenantId, status, channel, createdAt])
  @@map("notification_events")
}

model NotificationPreference {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vertical   String   @default("shared")
  type       String
  inApp      Boolean  @default(true)
  webPush    Boolean  @default(false)
  email      Boolean  @default(false)
  whatsapp   Boolean  @default(false)
  quietStart String?
  quietEnd   String?
  timezone   String   @default("America/Bogota")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, userId, vertical, type])
  @@index([tenantId, userId])
  @@index([tenantId, vertical, type])
  @@map("notification_preferences")
}

model WebPushSubscription {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint       String    @unique
  p256dh         String
  auth           String
  expirationTime DateTime?
  userAgent      String?
  deviceLabel    String?
  isActive       Boolean   @default(true)
  lastSeenAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, userId, isActive])
  @@index([tenantId, branchId, isActive])
  @@map("web_push_subscriptions")
}

enum NotificationChannel {
  IN_APP
  WEB_PUSH
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

// ─── Plataforma / Backoffice super-admin ──────────────────────────────────────
// Ver docs/BACKOFFICE_ARCHITECTURE.md §3.5 y §10.

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum BillingCycle {
  monthly
  yearly
}

// Suscripción comercial del tenant (plan + estado + ciclo + periodo).
// Es la fuente de verdad de billing; tenant.status es el estado operativo.
model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               String // "BASIC" | "PRO" | "PREMIUM" (consistente con Tenant.plan)
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(monthly)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  canceledAt         DateTime?
  priceCOP           Int?
  priceUSD           Int?
  provider           String             @default("manual") // 'manual' | 'stripe' | 'mercadopago'
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status])
  @@map("subscriptions")
}

// Histórico de pagos de suscripción (facturación manual MVP).
// Un pago cubre un periodo [periodStart, periodEnd]; si periodEnd es futuro y
// abarca varios ciclos, es un PAGO ANTICIPADO. Ver §3.6.
model SubscriptionPayment {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan            String // plan vigente al momento del pago
  amount          Int // monto entero
  currency        String       @default("COP") // 'COP' | 'USD'
  billingCycle    BillingCycle @default(monthly)
  periodStart     DateTime
  periodEnd       DateTime
  paidAt          DateTime     @default(now())
  method          String       @default("manual") // 'cash' | 'transfer' | 'card' | 'manual' | …
  reference       String?
  note            String?
  createdByUserId String // platform admin que registró el pago
  createdAt       DateTime     @default(now())

  @@index([tenantId, paidAt])
  @@index([paidAt])
  @@map("subscription_payments")
}

// Finanzas internas de la plataforma Lynko (NO tenant-scoped).
// Se usan en el backoffice super-admin para organizar gastos propios,
// metas comerciales y seguimiento financiero cross-tenant.
model PlatformExpense {
  id              String   @id @default(cuid())
  category        String // 'infra' | 'marketing' | 'payroll' | 'tools' | 'support' | 'taxes' | 'other'
  concept         String
  amount          Int
  currency        String   @default("COP") // 'COP' | 'USD'
  incurredAt      DateTime
  note            String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([incurredAt])
  @@index([incurredAt, currency])
  @@index([category, currency, incurredAt])
  @@index([category])
  @@map("platform_expenses")
}

model PlatformFinanceGoal {
  id              String   @id @default(cuid())
  periodMonth     String // "YYYY-MM"
  metric          String // 'revenue_cop' | 'profit_cop' | 'mrr_cop' | 'payments_count' | 'active_tenants'
  target          Int
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([periodMonth, metric])
  @@index([periodMonth])
  @@map("platform_finance_goals")
}

// Bitácora de toda mutación cross-tenant hecha desde el backoffice (§2).
model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String // 'tenant.status', 'subscription.suspend', 'user.disable', …
  targetType  String // 'tenant' | 'subscription' | 'user'
  targetId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}
